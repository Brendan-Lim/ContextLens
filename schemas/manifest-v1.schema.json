{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "mode": {
      "enum": [
        "visualFeedback",
        "referenceCapture"
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "timestampMS": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "imagePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "displayScale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "windowTitle": {
            "type": "string"
          },
          "applicationName": {
            "type": "string"
          },
          "captureReason": {
            "type": "string"
          },
          "changeScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "event": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "timestampMS",
          "name",
          "imagePath",
          "width",
          "height",
          "displayScale",
          "captureReason",
          "changeScore",
          "selected"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "annotation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "frameID": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "kind": {
                "enum": [
                  "rectangle",
                  "arrow",
                  "highlight",
                  "text",
                  "marker",
                  "redaction"
                ]
              },
              "region": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "instruction": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "frameID",
              "kind",
              "region",
              "points",
              "instruction",
              "severity"
            ],
            "additionalProperties": false
          },
          "annotatedPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
          },
          "cropPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[^/]+(?:/[^/]+)*$"
          }
        },
        "required": [
          "annotation",
          "annotatedPath",
          "cropPath"
        ],
        "additionalProperties": false
      }
    },
    "redactionApplied": {
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "sessionID",
    "mode",
    "frames",
    "issues",
    "redactionApplied"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextLens manifest-v1 v1"
}
